<section id="orbital-workshop" class="orbit-workshop panel" aria-labelledby="orbit-lab-title">
  <div class="section-heading section-heading--compact"><p class="eyebrow">Orbital Workshop</p><div class="heading-row"><div><h2 id="orbit-lab-title">A small, legible orbit.</h2><p>Adjust the initial conditions and watch a Newtonian two-body experiment unfold.</p></div><p data-orbit-status role="status" aria-live="polite" class="status-line">Loading local simulation…</p></div></div>
  <div class="orbit-workshop__layout">
    <div class="orbit-workshop__instrument"><canvas data-orbit-canvas class="orbit-canvas" aria-label="Illustrative view of a local Newtonian two-body orbit"></canvas><div class="orbit-readout"><p data-orbit-telemetry></p><span>Fixed-step local model</span></div></div>
    <aside class="orbit-controls" aria-label="Orbital experiment controls"><div class="control-intro"><p class="eyebrow">Initial conditions</p><p>Changes reset the experiment so each path has a clear beginning.</p></div><label>Altitude <span>km</span><input data-orbit-altitude type="number" min="1" max="50000" step="1" value="400" /></label><label>Circular-speed multiplier<input data-orbit-speed type="number" min="0" max="2" step="0.05" value="1" /></label><div class="button-row"><button data-orbit-pause class="button button--cyan" type="button" aria-pressed="false">Pause</button><button data-orbit-reset class="button button--quiet" type="button">Reset</button></div><details class="model-notes"><summary>Model notes and text alternative</summary><p data-orbit-text></p><p>Fixed spherical Earth, point satellite and no atmosphere, thrust, oblateness, Moon or Sun. This is a learning model, not a flight prediction.</p></details></aside>
  </div>
</section>
<script>
  import { mountOrbitalLab } from '../lib/orbital-lab'
  const canvas = document.querySelector<HTMLCanvasElement>('[data-orbit-canvas]')
  const status = document.querySelector<HTMLElement>('[data-orbit-status]')
  const altitudeInput = document.querySelector<HTMLInputElement>('[data-orbit-altitude]')
  const speedInput = document.querySelector<HTMLInputElement>('[data-orbit-speed]')
  const pauseButton = document.querySelector<HTMLButtonElement>('[data-orbit-pause]')
  const resetButton = document.querySelector<HTMLButtonElement>('[data-orbit-reset]')
  const telemetry = document.querySelector<HTMLElement>('[data-orbit-telemetry]')
  const textAlternative = document.querySelector<HTMLElement>('[data-orbit-text]')
  if (canvas && status && altitudeInput && speedInput && pauseButton && resetButton && telemetry && textAlternative) {
    mountOrbitalLab({ canvas, status, altitudeInput, speedInput, pauseButton, resetButton, telemetry, textAlternative })
  }
</script>
