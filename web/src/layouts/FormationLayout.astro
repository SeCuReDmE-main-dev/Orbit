---
import OrbitMark from '../components/OrbitMark.astro'
import '../styles/cosmic.css'
import '../styles/atom-games.css'
import '../styles/formation.css'
const {title, area='lab'}=Astro.props
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#07091b"/><title>{title} · Orbit.</title></head>
<body class="formation-page"><a class="skip-link" href="#learning-surface" data-formation-skip data-fr="Aller au contenu" data-en="Skip to content" data-es="Ir al contenido">Aller au contenu</a>
<div class="formation-shell" data-formation data-area={area}>
  <header class="formation-header"><a href="/" aria-label="Accueil Orbit" data-formation-aria-fr="Accueil Orbit" data-formation-aria-en="Orbit home" data-formation-aria-es="Inicio Orbit"><OrbitMark small/></a><nav aria-label="Formation" data-formation-aria-fr="Formation" data-formation-aria-en="Learning" data-formation-aria-es="Formación"><a href="/formation/lab/" data-fr="Laboratoire" data-en="Laboratory" data-es="Laboratorio">Laboratoire</a><a href="/formation/projets/" data-fr="Mes projets" data-en="My projects" data-es="Mis proyectos">Mes projets</a></nav><div data-formation-preferences></div></header>
  <div class="formation-context"><label><span data-fr="Module" data-en="Module" data-es="Módulo">Module</span><select data-module aria-label="Module" data-formation-aria-fr="Module" data-formation-aria-en="Module" data-formation-aria-es="Módulo"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option></select></label><span data-fr="40 h · 10 h accompagnées · 30 h solo" data-en="40 h · 10 h with your teacher · 30 h solo" data-es="40 h · 10 h con docente · 30 h individual">40 h · 10 h accompagnées · 30 h solo</span><button data-permissions data-fr="Partage et sauvegarde" data-en="Sharing and saving" data-es="Compartir y guardar">Partage et sauvegarde</button></div>
  <nav class="formation-tabs" data-learning-tabs aria-label="Vues" data-formation-aria-fr="Vues" data-formation-aria-en="Views" data-formation-aria-es="Vistas"></nav>
  <main id="learning-surface" data-learning-surface tabindex="-1" aria-label="Surface de travail" data-formation-aria-fr="Surface de travail" data-formation-aria-en="Work surface" data-formation-aria-es="Área de trabajo"><slot/><p data-fr="Ouverture de la session…" data-en="Opening the session…" data-es="Abriendo la sesión…">Ouverture de la session…</p></main>
  <footer class="formation-footer"><span data-learning-state></span><span data-tools-state></span><button data-export data-fr="Exporter ma session" data-en="Export my session" data-es="Exportar mi sesión">Exporter ma session</button></footer>
  <p class="formation-notice" data-learning-notice aria-live="polite"></p>
  <input type="file" data-learning-import accept="application/json,.json,.zip,.js,.ts,.astro,.md,.txt" hidden/>
  <dialog data-learning-dialog aria-label="Actions du dossier" data-formation-aria-fr="Actions du dossier" data-formation-aria-en="Dossier actions" data-formation-aria-es="Acciones del expediente"><button data-dialog-close aria-label="Fermer" data-formation-aria-fr="Fermer" data-formation-aria-en="Close" data-formation-aria-es="Cerrar">×</button><div data-dialog-body></div></dialog>
</div>
<script>import {mountLearningWorkspace} from '../lib/learning-workspace'; function mount(){const root=document.querySelector<HTMLElement>('[data-formation]');if(root&&!root.dataset.mounted){root.dataset.mounted='true';void mountLearningWorkspace(root)}}document.addEventListener('astro:page-load',mount);window.addEventListener('pageshow',mount);mount()</script>
</body></html>
