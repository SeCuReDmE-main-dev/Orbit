---
import OrbitLab from '../components/OrbitLab.astro'
import '../styles/global.css'
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Orbit Companion</title></head>
  <body>
    <main class="mx-auto max-w-5xl px-6 py-14">
      <p class="text-sm font-medium uppercase tracking-[0.22em] text-cyan-300">Local research companion</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-6xl">Trace sources. Bound claims. Keep the orbit understandable.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">The first vertical slice runs locally: a static Astro interface, a loopback broker, explicit provider blocks, and a fixed-step orbital visual.</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-3"><div class="rounded-xl bg-slate-900 p-4"><b>9 + 30</b><p class="mt-1 text-sm text-slate-400">calls and minutes</p></div><div class="rounded-xl bg-slate-900 p-4"><b>40 / 18</b><p class="mt-1 text-sm text-slate-400">candidates and claims</p></div><div class="rounded-xl bg-slate-900 p-4"><b>Depth 2</b><p class="mt-1 text-sm text-slate-400">bounded exploration</p></div></div>
      <div class="mt-10"><OrbitLab /></div>
      <section class="mt-8 rounded-2xl border border-slate-700 bg-slate-900/70 p-5" aria-labelledby="integration-status">
        <h2 id="integration-status" class="text-lg font-semibold">Integration status</h2>
        <dl class="mt-4 grid gap-3 text-sm">
          <div><dt class="font-medium text-slate-200">Local broker</dt><dd class="text-slate-400">Loopback only; start it separately before creating a mission.</dd></div>
          <div><dt class="font-medium text-slate-200">Codex, Antigravity, Exa and Sanity Knowledge Base</dt><dd class="text-amber-300">BLOCKED_EXTERNAL until each live connection is configured and verified.</dd></div>
          <div><dt class="font-medium text-slate-200">WebMCP</dt><dd data-webmcp-status class="text-slate-400">Checking browser support…</dd></div>
        </dl>
      </section>
    </main>
    <script>
      import { registerReadOnlyOrbitTools } from '../lib/webmcp'
      const status = document.querySelector<HTMLElement>('[data-webmcp-status]')
      registerReadOnlyOrbitTools()
        .then((result) => { if (status) status.textContent = result === 'registered' ? 'Five bounded read-only tools registered.' : 'Unavailable in this browser.' })
        .catch(() => { if (status) status.textContent = 'Registration failed; no tool was exposed.' })
    </script>
  </body>
</html>
