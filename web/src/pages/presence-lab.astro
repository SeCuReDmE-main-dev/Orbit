---
import OrbitLayout from '../layouts/OrbitLayout.astro'
import OrbitMark from '../components/OrbitMark.astro'
---
<OrbitLayout title="Atelier Orbit — présence 3D" bodyClass="presence-review">
  <header class="presence-header"><a href="/"><OrbitMark /></a><span>ATELIER DE PRÉSENCE</span><a class="text-button" href="/app/">Mon espace ↗</a></header>
  <main class="presence-studio">
    <div class="presence-wordmark" aria-hidden="true">orbit<span>.</span></div>
    <div class="presence-constellation" aria-hidden="true"></div>
    <h1 class="sr-only">Orbit, une présence à manipuler</h1>
    <section class="presence-volume" data-presence-host aria-label="Atelier du personnage Orbit">
      <canvas data-presence-canvas tabindex="0" aria-label="Orbit en particules. Glissez pour déplacer. Maj et glisser pour tourner. E disperse, R recentre. Flèches pour tourner, Maj et flèches pour déplacer."></canvas>
      <p data-presence-status role="status">Préparation de la présence…</p>
    </section>
    <aside class="presence-perspectives" aria-label="Angle de vue"><span>PERSPECTIVE</span><button type="button" data-camera="front" aria-pressed="true">01 <span>Face</span></button><button type="button" data-camera="three-quarter" aria-pressed="false">02 <span>Trois quarts</span></button><button type="button" data-camera="profile" aria-pressed="false">03 <span>Profil</span></button></aside>
    <div class="presence-dock"><nav aria-label="Manipuler la présence"><button type="button" data-review-scatter>Disperser</button><button type="button" data-review-reset>Reformer</button><button type="button" data-review-solid aria-pressed="false">Matière</button></nav><label><input type="checkbox" data-review-motion /> Mouvement réduit</label></div>
    <details class="presence-notes"><summary>Gestes et rendu</summary><p>Glissez pour déplacer, Maj + glisser pour tourner. E disperse et reforme ; R recentre. Les particules sont échantillonnées sur le modèle 3D ; leur mouvement est décoratif. Le mode Matière retrouve le volume articulé. Aucun microphone ni modèle IA n’est activé dans cet atelier.</p><a href="/guide/">Documentation ↗</a></details>
  </main>
  <script>
    import { mountPresence, type PresenceActivity } from '../../../packages/synthia-presence/src/index'
    const host=document.querySelector<HTMLElement>('[data-presence-host]')!
    const presence=mountPresence(host.querySelector('canvas')!,{modelUrl:'/presence-review/orbit-study.glb',animations:{idle:'Idle',listening:'Listening',thinking:'Thinking',speaking:'Speaking'}},{quality:'high',appearance:'particles',onStatus(state,message){host.dataset.status=state;host.querySelector('[data-presence-status]')!.textContent=state==='ready'?'Saisissez Orbit · Maj pour tourner · E pour disperser':message}})
    document.querySelector('[data-review-scatter]')!.addEventListener('click',()=>presence.scatter())
    document.querySelector('[data-review-reset]')!.addEventListener('click',()=>presence.reset())
    document.querySelector('[data-review-solid]')!.addEventListener('click',event=>{const button=event.currentTarget as HTMLButtonElement;const solid=button.getAttribute('aria-pressed')!=='true';presence.setAppearance(solid?'solid':'particles');button.setAttribute('aria-pressed',String(solid));button.textContent=solid?'Particules':'Matière'})
    document.querySelectorAll<HTMLButtonElement>('[data-activity]').forEach(button=>button.addEventListener('click',()=>{presence.setActivity(button.dataset.activity as PresenceActivity);document.querySelectorAll('[data-activity]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)))}))
    document.querySelectorAll<HTMLButtonElement>('[data-camera]').forEach(button=>button.addEventListener('click',()=>{presence.setView(button.dataset.camera as 'front'|'three-quarter'|'profile');document.querySelectorAll('[data-camera]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)))}))
    const motion=document.querySelector<HTMLInputElement>('[data-review-motion]')!;motion.checked=matchMedia('(prefers-reduced-motion: reduce)').matches
    motion.addEventListener('change',()=>presence.setReducedMotion(motion.checked))
  </script>
</OrbitLayout>
<style is:global>
.presence-review{margin:0;background:#07091b;color:#f7f5ff;font-family:var(--s-body);min-height:100svh}.presence-header{height:90px;padding:0 4vw;display:flex;align-items:center;justify-content:space-between;position:absolute;inset:0 0 auto;z-index:4}.presence-header a{text-decoration:none;color:#d7dcf6}.presence-header>span{font-size:10px;letter-spacing:.22em;color:#aaa9d0}.presence-studio{min-height:760px;height:100svh;position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 56% 32%,#71369855,transparent 40%),radial-gradient(ellipse at 76% 68%,#18639155,transparent 42%),radial-gradient(ellipse at 29% 65%,#dd874719,transparent 30%),#07091b}.presence-wordmark{position:absolute;z-index:-1;left:50%;top:47%;transform:translate(-50%,-50%);font:500 clamp(200px,37vw,690px)/1 var(--s-display);letter-spacing:-.08em;color:#b994ff12;white-space:nowrap;user-select:none}.presence-wordmark span{color:#ffc97a18}.presence-constellation{position:absolute;inset:0;z-index:-1;opacity:.3;background-image:radial-gradient(#9bcaff 1px,transparent 1px),radial-gradient(#bd98ff 1px,transparent 1px);background-size:89px 97px,137px 149px;background-position:14px 8px,61px 42px;mask-image:linear-gradient(transparent,#0008 30%,#000,transparent)}.presence-heading{position:absolute;left:7vw;top:35%;max-width:230px;pointer-events:none}.presence-heading>p:first-child{font-size:9px;letter-spacing:.18em;color:var(--s-gold)}.presence-heading h1{font:400 clamp(44px,6vw,90px)/1 var(--s-display);letter-spacing:-.05em;margin:18px 0;color:#f6f2ff}.presence-heading h1 span{color:var(--s-gold)}.presence-subtitle{font-size:14px;color:#b0bdd9}.presence-volume{position:absolute;inset:95px 17vw 136px 21vw;min-width:0}.presence-volume canvas{display:block;width:100%;height:100%;cursor:grab;touch-action:none;outline-offset:-8px}.presence-volume canvas:active{cursor:grabbing}.presence-volume [role=status]{position:absolute;bottom:-6px;inset-inline:0;margin:0;text-align:center;color:#bbb7db;font-size:10px;letter-spacing:.04em;pointer-events:none}.presence-perspectives{position:absolute;right:5vw;top:38%;display:flex;flex-direction:column;gap:20px}.presence-perspectives>span{font-size:8px;letter-spacing:.2em;color:#a09ab9}.presence-perspectives button{display:flex;gap:12px;align-items:center;text-align:left;border:0;border-left:1px solid #b3bbec30;background:none;color:#818db5;padding:7px 0 7px 13px;font-size:11px;cursor:pointer}.presence-perspectives button[aria-pressed=true]{border-color:var(--s-gold);color:var(--s-gold)}.presence-perspectives button span{font-size:12px;color:#d1d5ef}.presence-dock{position:absolute;bottom:55px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:30px;background:#101329bd;border:1px solid #bd98ff30;box-shadow:0 16px 60px #0005;border-radius:40px;padding:9px 22px 9px 9px;backdrop-filter:blur(18px);white-space:nowrap}.presence-dock nav{display:flex;gap:3px}.presence-dock button{border:0;border-radius:24px;background:transparent;color:#b9bce0;padding:12px 19px;font:400 13px var(--s-body);cursor:pointer}.presence-dock button[aria-pressed=true]{background:#bd98ff20;color:#e9dbff}.presence-dock button i{display:inline-block;width:5px;height:5px;background:var(--s-cyan);box-shadow:0 0 12px var(--s-cyan);border-radius:50%;margin-right:8px}.presence-dock label{display:flex;gap:7px;font-size:10px;color:#a6aed0;align-items:center}.presence-dock input{width:13px;height:13px;accent-color:var(--s-violet)}.presence-notes{position:absolute;left:4vw;bottom:14px;color:#9faacd;font-size:10px;max-width:420px}.presence-notes summary{cursor:pointer}.presence-notes[open]{background:#101329f5;border:1px solid var(--s-line);padding:16px;border-radius:8px;z-index:5}.presence-notes p{line-height:1.7}.presence-notes a{color:var(--s-cyan)}@media(max-width:850px){.presence-studio{min-height:670px}.presence-header{height:72px}.presence-header>span{display:none}.presence-heading{top:100px;left:7vw}.presence-heading h1{font-size:40px;margin:8px 0}.presence-heading>p:first-child{font-size:8px}.presence-subtitle{display:none}.presence-volume{inset:142px 5vw 155px}.presence-perspectives{top:96px;right:5vw;gap:6px}.presence-perspectives>span{display:none}.presence-perspectives button{padding:3px 0 3px 8px;font-size:9px}.presence-perspectives button span{font-size:10px}.presence-dock{bottom:50px;flex-direction:column;gap:8px;padding:9px 10px 12px;max-width:calc(100% - 28px);border-radius:22px}.presence-dock button{padding:10px 12px;font-size:11px}.presence-wordmark{font-size:59vw}.presence-notes{font-size:9px}}
</style>
<style is:global>
.presence-volume{inset:76px 3vw 112px}.presence-studio{min-height:620px}.presence-perspectives{right:4vw;top:30%;background:#10162a88;padding:15px;border-radius:20px;backdrop-filter:blur(12px)}.presence-wordmark{font-size:45vw}.presence-dock{bottom:40px}.presence-volume [role=status]{bottom:0}@media(max-width:850px){.presence-volume{inset:76px 0 160px}.presence-perspectives{top:84px;padding:8px;right:12px;background:transparent}.presence-dock{bottom:44px}.presence-studio{min-height:620px}}
</style>
