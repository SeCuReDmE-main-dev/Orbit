---

import OrbitLayout from '../layouts/OrbitLayout.astro'

import OrbitMark from '../components/OrbitMark.astro'

import GuideResearch from '../components/GuideResearch.astro'

import GuideAtom from '../components/GuideAtom.astro'

---

<OrbitLayout title="Orbit — Guide V3 · atome 2.1.7, formation et preuves" bodyClass="landing-page">

  <main class="orbit-guide">

    <nav><a class="brand-link" href="/" aria-label="Retour au jeu Orbit"><OrbitMark /></a><a class="text-button" href="/" data-fr="Retour à l’atome ↗" data-en="Back to the atom ↗" data-es="Volver al átomo ↗">Retour à l’atome ↗</a></nav>

    <p class="micro-label" data-fr="LE GUIDE · À CONSULTER À VOTRE RYTHME" data-en="THE GUIDE · AT YOUR OWN PACE" data-es="LA GUÍA · A TU RITMO">LE GUIDE · À CONSULTER À VOTRE RYTHME</p>

    <h1 data-fr="Jouer. Comprendre. Vérifier." data-en="Play. Understand. Verify." data-es="Jugar. Comprender. Verificar.">Jouer. Comprendre. Vérifier.</h1>

    <nav class="guide-index" aria-label="Sommaire"><a href="#release">V3 · 2.1.7</a><a href="#games" data-fr="15 jeux" data-en="15 games" data-es="15 juegos">15 jeux</a><a href="#access" data-fr="Accès" data-en="Access" data-es="Acceso">Accès</a><a href="#learning" data-fr="Apprendre" data-en="Learn" data-es="Aprender">Apprendre</a><a href="#workspace">Orbit</a><a href="#studio">Studio</a><a href="#tools">WebMCP</a></nav>

    <GuideAtom />

    <GuideResearch />

  </main>

</OrbitLayout>

<style>

 .orbit-guide{max-width:880px;margin:auto;padding:32px clamp(24px,5vw,60px) 90px}

 .guide-index{flex-wrap:wrap;gap:16px;margin-bottom:32px}li{color:#c1cbe4;line-height:1.8}

 nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:80px}

 h1{font:400 clamp(30px,4vw,48px)/1.15 var(--s-display);letter-spacing:-.035em;margin-bottom:55px}

 section{padding:26px 0;border-top:1px solid var(--s-line)}

 h2{font:500 25px var(--s-display);color:var(--s-gold)}

 p,dd{color:#c1cbe4;font:400 17px/1.8 var(--s-body)}

 dt{color:var(--s-cyan);margin-top:15px;font-weight:600}dd{margin-left:0}

</style>

